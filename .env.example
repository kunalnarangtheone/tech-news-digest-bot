# ================================
# Required Configuration
# ================================

# ================================
# Groq API Configuration (Required)
# ================================
# Sign up at https://console.groq.com/ for free API access
# Fast inference with llama-3.3-70b-versatile model

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ================================
# LangChain Agent Configuration
# ================================

# Enable LangChain agent for intelligent research
USE_LANGCHAIN_AGENT=true

# ================================
# LangGraph Multi-Agent Q&A System
# ================================

# Enable autonomous multi-agent Q&A with quality control
USE_LANGGRAPH=true

# Maximum number of autonomous retries when confidence is low
GRAPH_MAX_RETRIES=2

# Minimum confidence score to avoid triggering retry (0.0-1.0)
GRAPH_CONFIDENCE_THRESHOLD=0.6

# ================================
# Langfuse Observability (Optional)
# ================================
# Sign up at https://langfuse.com for tracing/observability
# Leave blank to disable

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ================================
# API Configuration
# ================================

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins for frontend (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Session configuration
SESSION_TTL_HOURS=24
